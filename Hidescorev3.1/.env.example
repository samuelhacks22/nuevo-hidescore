# Database Configuration (REQUIRED)
# Get this from Neon or your PostgreSQL provider
# Format: postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/hidescore?sslmode=require

# AI API Key (Optional)
# Remove or leave empty if you don't want AI recommendations
GEMINI_API_KEY=

# SMTP Configuration (Optional - for password reset emails)
# If not configured, password reset links will be logged to console
# For testing, you can use Ethereal Email: https://ethereal.email/
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-password
SMTP_FROM=noreply@hidescore.com

# Node Environment (Automatically set by Vercel)
NODE_ENV=production
