# Database Configuration (REQUIRED)
# Get this from Neon or your PostgreSQL provider
# Format: postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/hidescore?sslmode=require

# AI API Key (Optional)
# Remove or leave empty if you don't want AI recommendations
GEMINI_API_KEY=

# Node Environment (Automatically set by Vercel)
NODE_ENV=production
